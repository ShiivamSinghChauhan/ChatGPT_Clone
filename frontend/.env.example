# true  -> use the in-browser mock backend (no FastAPI needed)
# false -> call the real FastAPI backend
VITE_USE_MOCK=true

# Base path the browser calls. Keep "/api" in dev (Vite proxies it).
# In production point it at the deployed API, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Dev-server proxy target for /api (read by vite.config.ts, not exposed to the browser)
BACKEND_URL=http://localhost:8000
